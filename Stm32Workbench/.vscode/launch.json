{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Tigard: Attach Only (Blue Pill - STM32F1)",
            "type": "cortex-debug",
            "request": "attach",
            "cwd": "${workspaceFolder}",
            "executable": "./Gen3Images/blinky-TEMP.elf",
            "servertype": "openocd",
            "searchDir": [
                "${env:HOME}/projects/openocd-cfgs"
            ],
            "configFiles": [
                "interface/tigard.cfg",
                "target/stm32f1_tigard.cfg"
            ],
            "gdbPath": "/opt/arm-gnu-toolchain-15.2.rel1-x86_64-arm-none-eabi/bin/arm-none-eabi-gdb",
            "svdFile": "/opt/STMicroelectronics/STM32Cube/STM32CubeProgrammer/SVD/STM32F103.svd",
            "showDevDebugOutput": "raw"
        },
        {
            "name": "Tigard Debug (BluePill - STM32F1)",
            "type": "cortex-debug",
            "request": "launch",
            "cwd": "${workspaceFolder}",
            "executable": "./Gen3Images/blinky-TEMP.elf",
            "servertype": "openocd",
            "searchDir": [
                "${env:HOME}/projects/openocd-cfgs"
            ],
            "configFiles": [
                "interface/tigard.cfg",
                "target/stm32f1_tigard.cfg"
            ],
            "gdbPath": "/opt/arm-gnu-toolchain-15.2.rel1-x86_64-arm-none-eabi/bin/arm-none-eabi-gdb",
            "runToEntryPoint": "main",
            "svdFile": "/opt/STMicroelectronics/STM32Cube/STM32CubeProgrammer/SVD/STM32F103.svd",
            "showDevDebugOutput": "raw"
        }
    ]
}